def zenit_polar_replace(text):
    replacements = [('z','p'), ('e','o'), ('n','l'), ('i','a'), ('t','r'), 
                    ('Z','P'), ('E','O'), ('N','L'), ('I','A'), ('T','R')]

    for old , new in replacements:
         text = text.replace(old, new)
    return text

def main():
    phrase = "The princess kissed the frog and ate it for dinner."
    phrase_title = phrase.title()

    words = phrase_title.split()

    coded_words = [zenit_polar_replace(word) for word in words]

    coded_phrase = " ".join(coded_words)

    print("Original phrase: ", phrase)
    print("Title case phrase: ", phrase_title)
    print("Coded phrase: ", coded_phrase)

if __name__ == "__main__":
     main()
     




     









