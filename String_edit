with open("string.txt", "r", encoding='utf-8') as file:
    count = 0
    print("Representation of the file:")
    for line in file:
        print(repr(line))
        if line:
            count += 1
    print("Total number of the lines:", count)

with open("string.txt", "r", encoding='utf-8') as file:
    count = 0
    print("Representation of the file after strip:")
    for line in file:
        clean_line = line.strip()
        print(repr(clean_line))
        if clean_line:
            count += 1
    print("Total number of the lines after strip:", count)


