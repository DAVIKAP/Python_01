#Code4

import os

try:
    entry = os.scandir("my_directory")

    for object in entry:
        print(object)
        print("Nome:", object.name)
        print("Caminho:", object.path)
        print("Is a directory:", object.is_dir())
        print("Is a file:", object.is_file())
        if object.is_file():
            print("File size:", object.stat().st.size, "bytes")
        print("****************************************")

except FileNotFoundError as error:
    print("The directory does not exist.")
    print("Description", error)

except PermissionError as error:
    print("You do not have permission to access this directory.")
    print("Description", error)

