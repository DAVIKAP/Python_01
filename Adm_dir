import os
import errno

try:
    os.rmdir("my_directory.txt")
    print("Directory removed successfully.")

except OSError as error:
    print(error.errno)
    if error.errno == errno.ENOTEMPTY:
        print("The directory is not empty.")
    else:
        print("Unexpected error occurred while trying to remove the directory.")
        print("Descriotion", error)

print("Program completed.")

