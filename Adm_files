open ("file_to_remove.txt", "w")

import os
file_to_remove = "file_to_remove.txt"

try:
    os.remove(file_to_remove)
    print(f"The file {file_to_remove} has been removed successfully.")

except FileNotFoundError:
    print(f"The file {file_to_remove} does not exist.")

except Exception as e:
    print(f"An error occurred while trying to remove the file: {e}")

